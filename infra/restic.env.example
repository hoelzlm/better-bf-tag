# infra/restic.env.example — Vorlage für /etc/bftag/restic.env (Modus 600, niemals
# committen). Wird von bftag-backup.service via EnvironmentFile=/etc/bftag/restic.env
# geladen.

# restic-Repository auf der Hetzner Storage Box (uXXXXXX durch die eigene
# Storage-Box-Nummer ersetzen; 23 ist der SFTP-Port der Storage Box).
RESTIC_REPOSITORY=sftp:uXXXXXX@uXXXXXX.your-storagebox.de:23/bftag

# Pfad zu einer Datei, die NUR das restic-Repository-Passwort enthält (Modus 600).
# Alternativ RESTIC_PASSWORD direkt setzen (nicht empfohlen, landet im Prozess-Env).
RESTIC_PASSWORD_FILE=/etc/bftag/restic-password

# Verzeichnis mit docker-compose.yml auf dem Server (Standard: /opt/bftag).
BFTAG_DIR=/opt/bftag

# docker-compose-Projektname (Standard: bftag).
COMPOSE_PROJECT=bftag

# restic-Binary. Auf dem Server das per infra/provision.sh installierte restic
# verwenden (Standard "restic"). infra/test/backup-restore.sh überschreibt dies
# mit einem Docker-Wrapper, damit kein restic lokal installiert sein muss.
RESTIC_BIN=restic
