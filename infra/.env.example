# infra/.env.example — Vorlage für infra/.env (NIEMALS echte Werte committen).
# Kopieren nach infra/.env, Werte ausfüllen, chmod 600 infra/.env.

# Container-Image-Tag (siehe GHCR-Pakete). "latest" für den jeweils aktuellsten main-Stand.
BFTAG_TAG=latest

# Domain, unter der der Dienst erreichbar ist. Caddy holt dafür automatisch ein
# Let's-Encrypt-Zertifikat. Für lokale Tests "localhost" setzen — dann verwendet Caddy
# automatisch seine interne CA (kein echtes Zertifikat, aber TLS funktioniert).
BFTAG_DOMAIN=bf.example.de

# E-Mail-Adresse für Let's Encrypt (Ablauf-/Problem-Hinweise).
ACME_EMAIL=admin@example.de

# Ports, die Caddy auf dem Host belegt. Für den Produktivbetrieb 80/443 lassen.
HTTP_PORT=80
HTTPS_PORT=443

# Passwort für den Postgres-Benutzer "bftag". Zufällig und lang wählen, z. B.
# `openssl rand -base64 24`.
POSTGRES_PASSWORD=change-me

# Geheimnis zum Signieren der JWTs (Access-Token) und zum Signieren der Cookies.
# Mindestens 32 Zeichen, zufällig, z. B. `openssl rand -base64 32`.
JWT_SECRET=change-me-change-me-change-me-change-me

# Erlaubte CORS-Origins (kommasepariert). Bei einer Domain für Web + API meist leer lassen.
CORS_ORIGINS=

# Erstes Administrator-Konto, das beim ersten Start angelegt wird (falls noch keine
# Person mit diesem Benutzernamen existiert). Nach dem ersten Login kann es wieder aus
# der .env entfernt werden; die Person bleibt bestehen.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-change-me

# Anzeigename der eigenen Feuerwehr (z. B. in der Oberfläche).
OWN_FIRE_DEPARTMENT_NAME=Eigene Feuerwehr

# Rate-Limit für Login-/Auth-Endpunkte (Versuche pro Fenster). Für E2E-Testläufe
# hochsetzen (z. B. 1000), sonst laufen wiederholte Läufe in 429.
AUTH_RATE_LIMIT_MAX=10

# Push (ADR 0018): alle optional, ohne sie werden Pushes der jeweiligen
# Plattform abgelehnt (rejected). Dateien per Volume in den Backend-Container
# mounten und hier NUR den Pfad referenzieren, niemals den Inhalt.
# FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm-service-account.json
# APNS_KEY_FILE=/secrets/apns-key.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRODUCTION=false

# Wache (ADR 0026): Koordinaten für den Standort auf der Karte (z. B. Gerätehaus).
# Beide optional, aber nur gemeinsam gesetzt (sonst Config-Fehler beim Start).
# Ohne sie zeigt die Karte nur den Einsatz-Pin, ohne Wache-Symbol.
# STATION_LATITUDE=48.1234
# STATION_LONGITUDE=11.5678

# Geocoding-Proxy (ADR 0026): Adresssuche über Nominatim, ausschließlich über das
# Backend (nie direkt vom Client). GEOCODING_ENABLED=false schaltet die Suche ganz
# ab (liefert immer {results: []}). GEOCODING_URL kann auf eine eigene
# Nominatim-Instanz zeigen. GEOCODING_CONTACT (E-Mail) wird gemäß Nominatim
# Usage Policy empfohlen (https://operations.osmfoundation.org/policies/nominatim/)
# und als `email`-Parameter sowie im User-Agent mitgeschickt.
# GEOCODING_ENABLED=true
# GEOCODING_URL=https://nominatim.openstreetmap.org
# GEOCODING_CONTACT=admin@example.de

